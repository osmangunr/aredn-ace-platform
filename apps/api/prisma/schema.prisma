generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  OPERATOR
  VIEWER
  GATEWAY
  API
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  email     String?  @unique
  enabled   Boolean  @default(true)
  role      Role     @default(VIEWER)

  nodes     Node[]
  apiKeys   ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Node {
  id        String   @id @default(uuid())
  name      String
  callsign  String?  @unique
  type      String   @default("UNKNOWN")

  ip        String?
  mac       String?
  status    String   @default("offline")

  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])

  devices   Device[]
  lastSeen  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Device {
  id        String   @id @default(uuid())

  model     String
  firmware  String?

  battery   Float?
  voltage   Float?

  nodeId    String
  node      Node @relation(fields: [nodeId], references: [id])

  telemetry Telemetry[]

  createdAt DateTime @default(now())
}

model Telemetry {
  id          String   @id @default(uuid())

  rssi        Int?
  snr         Float?

  latitude    Float?
  longitude   Float?

  temperature Float?
  humidity    Float?

  deviceId    String
  device      Device @relation(fields: [deviceId], references: [id])

  createdAt   DateTime @default(now())
}


model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  role      Role     @default(GATEWAY)
  enabled   Boolean  @default(true)
  userId    String?
  user      User?    @relation(fields:[userId], references:[id])
  createdAt DateTime @default(now())
}
